# ============================================
# CBT CHATBOT CONFIGURATION - PRODUCTION
# ============================================
# Copy this file to .env and add your configuration

# Flask Configuration
FLASK_ENV=production
FLASK_DEBUG=false
SECRET_KEY=your-super-secret-key-change-this-in-production

# API Configuration
API_HOST=0.0.0.0
API_PORT=5000
API_BASE_URL=https://your-domain.com

# Frontend Configuration
FRONTEND_URL=https://your-domain.com

# JWT Configuration
JWT_SECRET_KEY=your-jwt-secret-key-change-this
JWT_EXPIRATION_HOURS=2

# Google Gemini AI Configuration
# Get your free API key from: https://aistudio.google.com/app/apikey
# Sign in with Google account → Click "Get API Key" → Create API Key
GEMINI_API_KEY=your-gemini-api-key-here
USE_AI=true

# Database Configuration
DATABASE_TYPE=sqlite
DATABASE_URL=sqlite:///chatbot.db
# For PostgreSQL (recommended for production):
# DATABASE_TYPE=postgresql
# DATABASE_URL=postgresql://user:password@localhost:5432/chatbot

# Logging Configuration
LOG_LEVEL=INFO
LOG_FILE=/var/log/chatbot/app.log

# Security
CORS_ORIGINS=https://your-domain.com,https://www.your-domain.com
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=3600

# Monitoring (optional)
SENTRY_DSN=

# Email Configuration (optional for failure notifications)
SMTP_SERVER=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
ADMIN_EMAIL=
